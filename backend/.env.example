# ─────────────────────────────────────────────────────────────────────────────
# daily-harness-analysis — backend environment variables
# Copy this file to .env and fill in real values before running bootstrap.sh.
#
#   cp .env.example .env
#
# Generate strong random values with:
#   openssl rand -hex 16
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────────────────
# Password for the miniflux Postgres user. Use a strong random value.
POSTGRES_PASSWORD=change_me_openssl_rand_hex_16

# ── Miniflux admin account ────────────────────────────────────────────────────
# Created automatically on first startup (CREATE_ADMIN=1).
# After bootstrap you should NOT store the password anywhere in the pipeline;
# the API token (minted by bootstrap.sh) is used instead.
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=change_me_openssl_rand_hex_16

# ── Miniflux base URL ─────────────────────────────────────────────────────────
# Used by Miniflux to generate share links etc.
# If you expose via a reverse proxy, put the public URL here.
MINIFLUX_BASE_URL=http://localhost:8080/

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — only needed when running with --profile proxy
# ─────────────────────────────────────────────────────────────────────────────

# Upstream SOCKS5 proxy URI for users behind a firewall.
# Format: socks5://user:pass@host:port  (or socks5://host:port for no auth)
# gost listens on :8118 and forwards traffic through this proxy.
# Not used unless you start the stack with:  docker compose --profile proxy up -d
# UPSTREAM_SOCKS5=socks5://user:pass@your.proxy.host:1080

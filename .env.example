# daily-harness-analysis — configuration
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# Every value below is read at runtime; nothing is hardcoded in the code.

# ── Feed backend (Miniflux) ──────────────────────────────────────────────
# Where the pipeline pulls the last N hours of entries from.
MINIFLUX_URL=http://127.0.0.1:8080
# API token: Miniflux web UI → Settings → API Keys → create. REQUIRED.
MINIFLUX_TOKEN=
# OPTIONAL. If Miniflux runs on another machine reachable over SSH, set the
# ssh host/alias here and the pipeline will `ssh <host> curl ...` instead of
# hitting MINIFLUX_URL locally. Leave empty when Miniflux is on this machine.
MINIFLUX_SSH_HOST=
# How far back each run looks (hours).
LOOKBACK_HOURS=24

# ── LLM engine ───────────────────────────────────────────────────────────
# The pipeline drives an agentic CLI for the digest + the deep, web-reading
# pass. Default is OpenAI's `codex` (https://github.com/openai/codex).
# Install: npm i -g @openai/codex
# Auth, pick ONE:
#   a) run `codex login`  (uses your ChatGPT account), or
#   b) set OPENAI_API_KEY below (codex uses the API instead).
LLM_CLI=codex
# OPENAI_API_KEY=

# ── Site branding (appears on the generated site) ────────────────────────
SITE_BRAND=Daily Harness Analysis
# Optional second line under the brand (a lab / org / your name). Empty = hidden.
SITE_TAGLINE=
# Public URL where the site is served. Used for canonical links + publish checks.
SITE_DOMAIN=http://localhost:8000
# The "view source" link shown top-right of the site. Point it at your fork.
SITE_REPO_URL=https://github.com/nmhjklnm/daily-harness-analysis
# Optional: clicking the brand goes here (your main site). Empty = links to "/".
SITE_HOME_URL=

# ── Paths (optional; sensible defaults derived from the repo root) ───────
# Per-day intermediate artifacts (raw json, digest, deep md, sources).
# OUTPUT_DIR=./daily
# The served static site directory (build.py writes <date>.html + index here).
# SITE_DIR=./site

# ── Publish / deploy (optional) ──────────────────────────────────────────
# none | vercel | netlify | rsync | command
DEPLOY_TARGET=none
# vercel:
VERCEL_TOKEN=
VERCEL_PROJECT=
VERCEL_SCOPE=
# netlify:
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
# rsync (e.g. user@host:/var/www/daily):
RSYNC_DEST=
# command: an arbitrary shell command run from SITE_DIR (advanced)
DEPLOY_COMMAND=
# How many times run.sh re-deploys + re-verifies before alerting.
PUBLISH_ATTEMPTS=3

# ── Failure alerts (optional) ────────────────────────────────────────────
# A POST webhook (ntfy / bark / slack-relay …). Empty = no push, just logs.
ALERT_WEBHOOK=
# Email alerts need both an address and an SMTP env file (see notify_fail.sh).
ALERT_EMAIL=
# SMTP_ENV_FILE=~/.config/mail/smtp.env
